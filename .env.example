# ─────────────────────────────────────────────
#  Tool Agent — Environment Configuration
# ─────────────────────────────────────────────
#  Copy this file to .env and fill in your values.
#  .env is git-ignored and never committed.

# LLM backend: "ollama" (local, free) | "groq" (free cloud) | "openai"
LLM_BACKEND=groq

# ── Groq (free cloud, recommended) ───────────
# Get a free API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=deepseek-r1-distill-llama-70b

# ── Tavily search (recommended) ───────────────
# Get a free key (1,000 searches/month) at https://tavily.com
# If not set, DuckDuckGo is used as a fallback (no key needed).
TAVILY_API_KEY=your_tavily_api_key_here

# ── Ollama (local, fully offline) ─────────────
# Install from https://ollama.com then run: ollama pull llama3.2
OLLAMA_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434

# ── OpenAI (optional, costs money) ───────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
